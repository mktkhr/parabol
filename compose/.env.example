# Copy to compose/.env and fill in every value marked CHANGE_ME.

# --- Public URL (TLS is terminated by your reverse proxy) ---
HOST=parabol.example.com
PROTO=https
PARABOL_PORT=3000
PORT=3000
SERVER_SECRET=CHANGE_ME_base64_random_32_bytes
NODE_ENV=production

# --- PostgreSQL (pgvector) ---
POSTGRES_USER=parabol
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=parabol
POSTGRES_USE_PGVECTOR=true

# --- Valkey ---
VALKEY_USER=parabol
VALKEY_PASSWORD=CHANGE_ME

# --- llama-swap ---
# GGUF specs accepted by llama-server -hf (repo:quant). Embedding model must produce 1024 dimensions.
LLAMA_GENERATION_MODEL=unsloth/Qwen3-8B-GGUF:Q4_K_M
LLAMA_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B-GGUF:Q8_0
LLAMA_GPU_COUNT=all
# CUDA 13 (Ampere or newer):
# LLAMA_SWAP_IMAGE=ghcr.io/mostlygeek/llama-swap:unified-cuda13-rootless-2026-09-15@sha256:d88e36488522ddcf9a99d52903648337fc807ce5d11b01b4fa779d4d0e7b5bd5

# --- Parabol AI features (served by llama-swap through the OpenAI-compatible API) ---
OPEN_AI_API_KEY=local
AI_EMBEDDING_MODELS=[{"model":"vllm:Qwen/Qwen3-Embedding-0.6B","url":"http://llama-swap:8080/upstream/embedding/v1","maxTokens":4096}]
AI_GENERATION_MODELS=[{"model":"openai:gpt-4-turbo-preview","url":"http://llama-swap:8080/v1","maxTokens":4096}]
AI_EMBEDDER_WORKERS=1

# --- OIDC (enables OIDC login and disables every other auth method) ---
OIDC_ISSUER=https://gitlab.example.com
OIDC_CLIENT_ID=CHANGE_ME
OIDC_CLIENT_SECRET=CHANGE_ME
OIDC_SCOPES=openid email profile
OIDC_GROUPS_CLAIM=groups
OIDC_ALLOWED_GROUPS=
OIDC_BUTTON_LABEL=Log in with GitLab

# --- Storage / mail ---
FILE_STORE_PROVIDER=local
CDN_BASE_URL=
MAIL_PROVIDER=debug
